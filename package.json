{
  "name": "gameshelves",
  "homepage": "http://www.kavispires.com/gameshelves/",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "yarn dev",
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview",
    "serve": "yarn preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "lint": "yarn run check",
    "format": "biome check --write .",
    "prepare": "husky",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.72.0",
    "papaparse": "^5.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "csstype": "^3.2.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,jsonc,css,html}": "biome check --write --no-errors-on-unmatched"
  }
}
